# Copy this file to .env and fill in the values. .env is gitignored.

# Your ElevenLabs API key.
ELEVENLABS_API_KEY=

# The voice to synthesise with. Find voice IDs in your ElevenLabs dashboard.
ELEVENLABS_VOICE_ID=weA4Q36twV5kwSaTEL0Q

# Serial device the microcontroller shows up as on the Mac mini.
# Optional: the port is auto-detected by USB vendor ID, so leave this blank unless
# you need to force a specific device (e.g. another serial adapter is plugged in).
# Run `python main.py --list-ports` to see detected ports.
# SERIAL_PORT=/dev/tty.usbmodem101

# Serial baud rate. Must match the controller firmware.
SERIAL_BAUD=115200
